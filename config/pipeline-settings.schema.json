{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/judmir/validation-ideas/blob/main/config/pipeline-settings.schema.json",
  "title": "Validation Ideas pipeline settings",
  "description": "Shape of pipeline_settings_versions.settings in Supabase (the source of truth; routines read pipeline_settings_latest). config/pipeline-settings.json is version 1 and the offline fallback. TS type: lib/settings.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scouting",
    "scoring",
    "winner",
    "poc",
    "validation",
    "schedule"
  ],
  "properties": {
    "scouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markets",
        "sources",
        "proven_models",
        "complaints_per_night",
        "complaint_lookback_days",
        "exclude_regulated_finance_medical"
      ],
      "properties": {
        "markets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "US",
            "DE"
          ],
          "properties": {
            "US": {
              "type": "boolean"
            },
            "DE": {
              "type": "boolean"
            }
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "app_store",
            "google_play",
            "reddit_arctic_shift",
            "x",
            "hacker_news",
            "trustpilot",
            "niche_forums"
          ],
          "properties": {
            "app_store": {
              "type": "boolean"
            },
            "google_play": {
              "type": "boolean"
            },
            "reddit_arctic_shift": {
              "type": "boolean"
            },
            "x": {
              "type": "boolean"
            },
            "hacker_news": {
              "type": "boolean"
            },
            "trustpilot": {
              "type": "boolean"
            },
            "niche_forums": {
              "type": "boolean"
            }
          }
        },
        "proven_models": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "min",
            "max"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "complaints_per_night": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "complaint_lookback_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "exclude_regulated_finance_medical": {
          "type": "boolean"
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria",
        "criterion_scale",
        "max_score",
        "winning_bar",
        "near_miss_band",
        "competitor_veto",
        "gates"
      ],
      "properties": {
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frequency",
            "intensity",
            "willingness_to_pay",
            "reachability",
            "buildability"
          ],
          "properties": {
            "frequency": {
              "type": "number",
              "minimum": 0,
              "maximum": 5,
              "multipleOf": 0.5
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 5,
              "multipleOf": 0.5
            },
            "willingness_to_pay": {
              "type": "number",
              "minimum": 0,
              "maximum": 5,
              "multipleOf": 0.5
            },
            "reachability": {
              "type": "number",
              "minimum": 0,
              "maximum": 5,
              "multipleOf": 0.5
            },
            "buildability": {
              "type": "number",
              "minimum": 0,
              "maximum": 5,
              "multipleOf": 0.5
            }
          },
          "description": "Weight per criterion (1 = default)."
        },
        "criterion_scale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "const": 1
            },
            "max": {
              "const": 5
            }
          }
        },
        "max_score": {
          "type": "number",
          "description": "Derived: 5 \u00d7 sum of weights. Kept in sync by the settings page."
        },
        "winning_bar": {
          "type": "number",
          "minimum": 0,
          "maximum": 25
        },
        "near_miss_band": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0,
              "maximum": 25
            },
            "max": {
              "type": "number",
              "minimum": 0,
              "maximum": 25
            }
          }
        },
        "competitor_veto": {
          "type": "boolean"
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consumer_subscription",
            "buildable_2_weeks",
            "us_entry_point",
            "plc_decline_kills",
            "simplest_way_flag"
          ],
          "properties": {
            "consumer_subscription": {
              "type": "boolean"
            },
            "buildable_2_weeks": {
              "type": "boolean"
            },
            "us_entry_point": {
              "type": "boolean"
            },
            "plc_decline_kills": {
              "type": "boolean"
            },
            "simplest_way_flag": {
              "type": "boolean",
              "description": "Build principle (flag only), not a gate."
            }
          },
          "description": "Maps onto the gate ids in lib/gates.ts."
        }
      }
    },
    "winner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ideas_per_brief",
        "no_repeats",
        "prefer_stronger_plc_on_tie",
        "fallback"
      ],
      "properties": {
        "ideas_per_brief": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "no_repeats": {
          "const": true
        },
        "prefer_stronger_plc_on_tie": {
          "type": "boolean"
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "min_score",
            "allow_vetoed",
            "allow_plc_maybe"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "min_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 25
            },
            "allow_vetoed": {
              "type": "boolean"
            },
            "allow_plc_maybe": {
              "type": "boolean"
            }
          },
          "description": "Always build at least one demo, labelled 'Fallback (below bar)'. A PLC 'no' is never allowed."
        }
      }
    },
    "poc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "max_per_night",
        "ready_by",
        "private_only"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_per_night": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "ready_by": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "private_only": {
          "const": true
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "ad_budget_eur",
        "min_visitors",
        "strong_price_click_pct",
        "kill_price_click_pct",
        "two_button_page"
      ],
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "active"
          ]
        },
        "ad_budget_eur": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "min_visitors": {
          "type": "integer",
          "minimum": 0
        },
        "strong_price_click_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "kill_price_click_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "two_button_page": {
          "type": "boolean"
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "us_scout",
        "analyst",
        "builder",
        "brief",
        "weekly",
        "read_only"
      ],
      "properties": {
        "timezone": {
          "const": "Europe/Berlin"
        },
        "us_scout": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "analyst": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "builder": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "brief": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "weekly": {
          "type": "string"
        },
        "read_only": {
          "const": true
        }
      }
    }
  }
}
